{
  "name": "batvu",
  "version": "0.1.0",
  "private": true,
  "description": "BatVu — iPhone acoustic sonar: see a room the way a bat does. Part of the ruview spatial-intelligence effort.",
  "homepage": "https://github.com/ruvnet/batvu",
  "repository": { "type": "git", "url": "https://github.com/ruvnet/batvu.git" },
  "license": "MIT",
  "author": "rUv <ruv@ruv.net>",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:wasm": "node scripts/build-wasm.mjs",
    "build": "npm run build:wasm && node scripts/build-ordered.mjs",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path crates/batvu-dsp/Cargo.toml --release",
    "bench": "node bench/run-bench.mjs",
    "bench:rust": "cargo test --manifest-path crates/batvu-dsp/Cargo.toml --release -- --ignored --nocapture bench_",
    "lint": "npm run -ws --if-present lint",
    "fmt:rust": "cargo fmt --manifest-path crates/batvu-dsp/Cargo.toml --all",
    "clippy": "cargo clippy --manifest-path crates/batvu-dsp/Cargo.toml --all-targets -- -D warnings",
    "flywheel": "node packages/batvu-flywheel/scripts/run-flywheel.mjs",
    "demo": "node packages/batvu-horizon/scripts/demo.mjs",
    "web:dev": "node packages/batvu-web/scripts/serve.mjs",
    "e2e": "node e2e/run-e2e.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "engines": { "node": ">=20.0.0" }
}
